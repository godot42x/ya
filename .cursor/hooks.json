{
  "version": 1,
  "hooks": {
    "subagentStart": [
      {
        "command": "python3 .cursor/hooks/subagent-reuse-gate.py",
        "timeout": 10,
        "failClosed": true
      }
    ],
    "stop": [
      {
        "command": "python3 .cursor/hooks/subagent-reuse-followup.py",
        "timeout": 10,
        "loop_limit": 1
      }
    ]
  }
}
