# GUIWorkbench --start-page=Theme. Theme switches from View → Light Theme.
# Inputs target widgets from the live tree: the View menu opens under
# MenuBar_View and the entry is addressed by its label-derived name, so the
# scenario survives shell padding and menu-entry changes.
{"window_size":{"width":1280,"height":720}}
{"frame":3}
{"assert":{"widget":"ThemeShowButton"}}
{"assert":{"widget":"ThemeAccentButton"}}
{"assert":{"widget":"ThemeShowPanel"}}
{"checkpoint":"theme_dark"}
{"click":{"widget":"MenuBar_View"}}
{"frame":2}
{"click":{"widget":"Menu_Light Theme"}}
{"frame":2}
{"assert":{"widget":"ThemeShowButton"}}
{"assert":{"widget":"ThemeShowPanel"}}
{"assert_validation_clean":true}
{"checkpoint":"theme_light"}
{"frame":1}
