# GUIWorkbench --start-page=ScrollSplit. The split divider and the scroll area
# are addressed by widget (part:"handle" is DemoSplit's divider rect), so the
# same deltas hold at every window size without re-measured pixel tables.
{"window_size":{"width":1280,"height":800}}
{"frame":2}
{"assert":{"widget":"DemoSplit","rect":{"w":{"$gt":0},"h":{"$gt":0}},"control":{"type":"splitPane","ratio":{"$gt":0.37}}}}
{"checkpoint":"initial"}
{"drag":{"widget":"DemoSplit","part":"handle","by":[100,0],"steps":8}}
{"wheel":{"widget":"DemoScroll","dy":-4}}
{"frame":3}
{"assert":{"widget":"DemoSplit","control":{"type":"splitPane","ratio":{"$gt":0.4}}}}
{"assert":{"widget":"DemoScroll","control":{"type":"scrollViewport","offset":{"$gt":0},"maxOffset":{"$gt":0}}}}
{"checkpoint":"after_initial_interaction"}
