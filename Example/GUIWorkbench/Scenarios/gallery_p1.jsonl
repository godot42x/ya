# GUIWorkbench --start-page=Dialog --scenario-render. Tooltip dwell and
# UIDialog. (The tooltip dwell counts rendered frames, so this scenario
# needs --scenario-render.) Hover and click targets are named widgets.
{"window_size":{"width":1280,"height":720}}
{"frame":3}
{"assert":{"widget":"OpenModal"}}
{"assert":{"widget":"TooltipBtn"}}
{"assert":{"widget":"OpenDialogBtn"}}
{"checkpoint":"dialog_widgets"}
# Hover TooltipBtn, then move to OpenModal to clear the tooltip.
{"event":"mouse_move","widget":"TooltipBtn"}
{"frame":35}
{"assert":{"widget":"TooltipHost"}}
{"checkpoint":"tooltip_shown"}
{"event":"mouse_move","widget":"OpenModal"}
{"frame":2}
{"assert":{"layers":{"Tooltip":{"children":[]}}}}
{"checkpoint":"tooltip_cleared"}
# Open the modal dialog and confirm it with its OK button.
{"click":{"widget":"OpenDialogBtn"}}
{"frame":2}
{"assert":{"widget":"Dialog","control":{"type":"popupOverlay","modal":true}}}
{"checkpoint":"dialog_open"}
{"click":{"widget":"DialogOK"}}
{"frame":2}
{"assert":{"layers":{"Popup":{"children":[]}}}}
{"checkpoint":"dialog_confirmed"}
{"frame":1}
