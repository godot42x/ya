# GUIWorkbench --start-page=Dock. Leaf tab close + same-leaf reorder.
# Hierarchy/Assets share the west leaf; Scene is not closable; Console is.
{"window_size":{"width":1280,"height":720}}
{"frame":3}
{"assert":{"widget":"Tab_Hierarchy","control":{"type":"tabButton","closable":true}}}
{"assert":{"widget":"Tab_Assets","control":{"type":"tabButton","closable":true}}}
{"assert":{"widget":"Tab_Scene","control":{"type":"tabButton","closable":false}}}
{"assert":{"widget":"Tab_Console","control":{"type":"tabButton","closable":true}}}
{"assert":{"widget":"DockTabBar4","control":{"type":"tabBar","tabs":["Hierarchy","Assets"]}}}
{"checkpoint":"dock_tabs"}
# Drag Assets onto the left edge of Hierarchy. Ending on that edge keeps the
# swapped tab under the pointer so a live reorder does not swap back.
{"drag":{"widget":"Tab_Assets","to_widget":"Tab_Hierarchy","to_at":[0.0,0.5],"steps":12}}
{"frame":3}
{"assert":{"widget":"DockTabBar4","control":{"type":"tabBar","tabs":["Assets","Hierarchy"]}}}
{"checkpoint":"leaf_reordered"}
# The close affordance is the tab's trailing hit-zone, addressed as part:"close".
{"click":{"widget":"Tab_Console","part":"close"}}
{"frame":3}
{"assert":{"widget":"!Tab_Console"}}
{"assert":{"widget":"!DockStack7"}}
{"checkpoint":"console_closed"}
{"frame":1}
