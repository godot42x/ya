# GUIWorkbench --start-page=Gallery. TreeView editing capabilities: filter
# narrows the visible rows; the table grid hosts a real button widget in a
# cell. Coordinates assume the window size below with the gallery scrolled.
{"window_size":{"width":1280,"height":720}}
{"frame":3}
{"assert":{"widget":"GalleryTree","control":{"type":"treeView"}}}
{"assert":{"widget":"GalleryCellButton","control":{"type":"button"}}}
{"checkpoint":"editing_widgets"}
# Click the filter field (page top, ~ (151, 604)) and type 'Li': only the
# Light chain stays visible (light + point + spot = 3 rows).
{"event":"mouse_press","x":151,"y":604,"button":0}
{"event":"mouse_release","x":151,"y":604,"button":0}
{"event":"key_typed","text":"Li"}
{"frame":2}
{"assert":{"widget":"GalleryTree","control":{"type":"treeView","visibleRows":4}}}
{"checkpoint":"tree_filtered"}
# Manual collapse still works while the filter is active (the filter
# expands matching chains once, then manual toggles stay authoritative).
{"event":"mouse_press","x":43,"y":495,"button":0}
{"event":"mouse_release","x":43,"y":495,"button":0}
{"frame":2}
{"assert":{"widget":"GalleryTree","control":{"type":"treeView","visibleRows":2}}}
{"checkpoint":"collapse_while_filtered"}
{"frame":1}
