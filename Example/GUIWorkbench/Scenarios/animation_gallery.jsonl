# GUIWorkbench --start-page=Tween. Framework animation gallery: every case on
# the page is exercised with a real interaction (coordinates read from a tree
# dump), so the tweens actually run while frames are produced. The G2 validation
# frame every 60 frames diffs the incremental paint against a full repaint, so a
# stale paint-after-tween regression fails this scenario too.
{"window_size":{"width":1280,"height":720}}
{"frame":3}
{"assert":{"widget":"AnimationDemo"}}
{"assert":{"widget":"AnimationCard"}}
{"assert":{"widget":"AnimationToastCard"}}
{"assert":{"widget":"AnimationToastStripe"}}
{"assert":{"widget":"AnimationGroup"}}
{"assert":{"widget":"AnimationGroupCard2"}}
{"assert":{"widget":"AnimationStagger"}}
{"assert":{"widget":"AnimationStaggerCard4"}}
{"assert":{"widget":"AnimationGauge"}}
{"assert":{"widget":"AnimSwitchFast"}}
{"assert":{"widget":"AnimSwitchSlow"}}
{"assert":{"widget":"AnimSwitchInstant"}}
{"assert":{"widget":"AnimSwitchOn"}}
{"checkpoint":"animation_gallery_built"}

# Leaf tweens on a single card (paint-only overlay, one rebuilt widget).
{"event":"mouse_press","x":382,"y":144}
{"event":"mouse_release","x":382,"y":144}
{"frame":6}
{"event":"mouse_press","x":500,"y":144}
{"event":"mouse_release","x":500,"y":144}
{"frame":6}
{"event":"mouse_press","x":648,"y":144}
{"event":"mouse_release","x":648,"y":144}
{"frame":6}
{"event":"mouse_press","x":786,"y":144}
{"event":"mouse_release","x":786,"y":144}
{"frame":4}
{"assert":{"widget":"AnimationCard"}}
{"checkpoint":"animation_gallery_leaf"}

# Keyframe curve (slide in -> hold -> out) on one clock.
{"event":"mouse_press","x":382,"y":308}
{"event":"mouse_release","x":382,"y":308}
{"frame":40}
{"assert":{"widget":"AnimationToastCard"}}
{"assert":{"widget":"AnimationToastStripe"}}
{"frame":60}
{"checkpoint":"animation_gallery_curve"}

# Default-animated control: pointer toggle then keyboard toggle on the switch.
{"event":"mouse_press","x":1053,"y":165}
{"event":"mouse_release","x":1053,"y":165}
{"frame":4}
{"event":"key_press","key":"space"}
{"event":"key_release","key":"space"}
{"frame":4}
{"assert":{"widget":"AnimSwitchFast"}}
{"checkpoint":"animation_gallery_switch"}

# "Toggle all" drives three switches from one handler: it used to hand the
# buttons a handle that the builder had already released.
{"event":"mouse_press","x":918,"y":273}
{"event":"mouse_release","x":918,"y":273}
{"frame":6}
{"assert":{"widget":"AnimSwitchSlow"}}
{"checkpoint":"animation_gallery_toggle_all"}

# Sequence (stagger) — five chained leaf tweens running at once.
{"event":"mouse_press","x":392,"y":526}
{"event":"mouse_release","x":392,"y":526}
{"frame":20}
{"assert":{"widget":"AnimationStaggerCard0"}}
{"assert":{"widget":"AnimationStaggerCard4"}}
{"checkpoint":"animation_gallery_stagger"}

# Subtree transition, including a mid-flight reverse (playToward).
{"event":"mouse_press","x":382,"y":419}
{"event":"mouse_release","x":382,"y":419}
{"frame":4}
{"event":"mouse_press","x":500,"y":419}
{"event":"mouse_release","x":500,"y":419}
{"frame":8}
{"assert":{"widget":"AnimationGroup"}}
{"checkpoint":"animation_gallery_group"}

# App widget's own animatable property.
{"event":"mouse_press","x":918,"y":381}
{"event":"mouse_release","x":918,"y":381}
{"frame":30}
{"assert":{"widget":"AnimationGauge"}}
{"checkpoint":"animation_gallery_gauge"}
{"assert_validation_clean":true}
