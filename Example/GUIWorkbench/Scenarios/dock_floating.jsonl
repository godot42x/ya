# GUIWorkbench --start-page=Dock. Floating host is bound on the Dock page
# (bAllowTearOff / bAllowFloating). Headless tear-off onto empty chrome is
# currently swallowed by DockSpace's drop target (Dropped, not NoTarget),
# so this scenario locks the host + tabs by name. Live Workbench still
# demonstrates drag-out floating.
{"window_size":{"width":1280,"height":720}}
{"frame":3}
{"assert":{"widget":"DockSplit1"}}
{"assert":{"widget":"Tab_Scene"}}
{"assert":{"widget":"DemoFloatingHost"}}
{"checkpoint":"dock_floating_host"}
{"frame":1}
