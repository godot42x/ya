# GUIWorkbench --start-page=Dock. Floating smoke: tear a tab out into a
# floating window, then re-dock it back onto the dock by GRABBING THE WINDOW
# BY ITS TITLE (header empty area — the dock regression: grabbing the title
# used to do nothing; only the tab strip could start the dock-panel drag).
{"window_size":{"width":1280,"height":720}}
{"frame":3}
{"assert":{"widget":"DockLeaf1"}}
{"checkpoint":"dock_initial"}
# Tear off the Scene tab: drag it up into the toolbar (above the DockSpace) and release.
{"drag":{"from":[40,79],"to":[300,40],"button":0,"steps":8}}
{"frame":3}
{"assert":{"widget":"FloatingWindow1"}}
{"checkpoint":"dock_torn"}
# Re-dock by the floating window's TITLE at x=400 (beyond the tab strip,
# which ends at ~255, and the close button at ~355): dragging it onto the
# DockSpace content center must re-dock the panel.
{"drag":{"from":[400,160],"to":[700,300],"button":0,"steps":8}}
{"frame":3}
{"checkpoint":"after_redock"}
{"frame":3}
{"assert":{"widget":"!FloatingWindow1"}}
{"assert":{"widget":"DockLeaf1"}}
{"checkpoint":"dock_redocked"}
{"frame":1}