# GUIWorkbench --start-page=Gallery. Automated acceptance for the input
# extras fixes: page scrolling, double-click text entry (DragFloat/SpinBox),
# and ColorEdit channel selection. Coordinates assume the window size below
# and scrolling the gallery to the bottom (offset clamps to maxOffset).
{"window_size":{"width":1280,"height":720}}
{"frame":3}
{"assert":{"widget":"GalleryScroll","control":{"type":"scrollViewport"}}}
{"checkpoint":"scroll_exists"}
