# Double-click DragFloat (scrolled position ~ (155, 339)) and type 1.5.
{"event":"mouse_press","x":155,"y":339,"button":0}
{"event":"mouse_release","x":155,"y":339,"button":0}
{"event":"mouse_press","x":155,"y":339,"button":0}
{"event":"mouse_release","x":155,"y":339,"button":0}
{"event":"key_typed","text":"1.5"}
{"event":"key_press","key":"Enter"}
{"frame":2}
{"assert":{"widget":"GalleryDragFloat","control":{"type":"dragFloat","value":1.5}}}
{"checkpoint":"dragfloat_edited"}
# Single-click the SpinBox middle value area (scrolled position ~ (139, 375))
# enters edit mode directly; type 4.
{"event":"mouse_press","x":139,"y":375,"button":0}
{"event":"mouse_release","x":139,"y":375,"button":0}
{"event":"key_typed","text":"4"}
{"event":"key_press","key":"Enter"}
{"frame":2}
{"assert":{"widget":"GallerySpinBox","control":{"type":"spinBox","value":4.0}}}
{"checkpoint":"spinbox_edited"}
# Click the ColorEdit alpha channel cell (scrolled position ~ (222, 447))
# to select channel 3; the swatch drag path is visually verified by hand.
{"event":"mouse_press","x":222,"y":447,"button":0}
{"event":"mouse_release","x":222,"y":447,"button":0}
{"frame":2}
{"assert":{"widget":"GalleryColorEdit","control":{"type":"colorEdit","activeChannel":3}}}
{"checkpoint":"color_channel_selected"}
# Click the swatch (scrolled position ~ (107, 446)): the preset palette
# popup opens below it.
{"event":"mouse_press","x":107,"y":446,"button":0}
{"event":"mouse_release","x":107,"y":446,"button":0}
{"frame":2}
{"assert":{"widget":"ColorPaletteOverlay","control":{"type":"popupOverlay","modal":false}}}
{"checkpoint":"palette_open"}
# Pick the first palette cell (scrolled position ~ (110, 472)): the overlay
# closes itself after the pick.
{"event":"mouse_press","x":110,"y":472,"button":0}
{"event":"mouse_release","x":110,"y":472,"button":0}
{"frame":2}
{"assert":{"layers":{"Popup":{"children":[]}}}}
{"checkpoint":"palette_picked"}
{"frame":1}
