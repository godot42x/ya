# GUIWorkbench --start-page=Inputs. Automated acceptance for the input
# extras: double-click text entry (DragFloat/SpinBox), ColorEdit channel
# selection, and SearchCombo filter/pick. Every input targets a named widget
# from the live tree; the picker's SV square sits at a fixed inset inside
# ColorPicker (8px pad, 160px square) and is addressed through normalized
# anchors.
{"window_size":{"width":1280,"height":720}}
{"frame":3}
{"assert":{"widget":"GalleryDragFloat","control":{"type":"dragFloat","value":3.5}}}
{"assert":{"widget":"GallerySpinBox","control":{"type":"spinBox","value":8.0}}}
{"assert":{"widget":"GalleryColorEdit","control":{"type":"colorEdit"}}}
{"assert":{"widget":"GallerySearchCombo","control":{"type":"searchComboBox","selectedIndex":0}}}
{"checkpoint":"inputs_present"}
# Double-click GalleryDragFloat and type 1.5.
{"click":{"widget":"GalleryDragFloat"}}
{"click":{"widget":"GalleryDragFloat"}}
{"event":"key_typed","text":"1.5"}
{"event":"key_press","key":"Enter"}
{"frame":2}
{"assert":{"widget":"GalleryDragFloat","control":{"type":"dragFloat","value":1.5}}}
{"checkpoint":"dragfloat_edited"}
# Click GallerySpinBox center (value area, not the +/- ends); type 4.
{"click":{"widget":"GallerySpinBox"}}
{"event":"key_typed","text":"4"}
{"event":"key_press","key":"Enter"}
{"frame":2}
{"assert":{"widget":"GallerySpinBox","control":{"type":"spinBox","value":4.0}}}
{"checkpoint":"spinbox_edited"}
# Channel cells are the named DragFloat children of the ColorEdit.
{"click":{"widget":"ChannelA"}}
{"frame":2}
{"assert":{"widget":"GalleryColorEdit","control":{"type":"colorEdit"}}}
{"checkpoint":"color_channel_selected"}
# Swatch is the named swatch child; the picker opens below (page is not near the bottom).
{"click":{"widget":"Swatch"}}
{"frame":2}
{"assert":{"widget":"ColorPickerOverlay","control":{"type":"popupOverlay","modal":false}}}
{"assert":{"widget":"ColorPicker","control":{"type":"colorPicker"}}}
{"assert":{"widget":"GalleryColorEdit","control":{"type":"colorEdit","pickerOpen":true}}}
{"checkpoint":"picker_open"}
# SV square is a fixed 160px region inset 8px into the 176px-wide picker:
# [0.77,0.39] lands at s≈0.80, v≈0.49 (toward high saturation).
{"click":{"widget":"ColorPicker","at":[0.77,0.39]}}
{"frame":2}
{"assert":{"widget":"GalleryColorEdit","control":{"type":"colorEdit","pickerOpen":true}}}
{"assert":{"widget":"ColorPicker","control":{"type":"colorPicker","s":{"$gt":0.72},"v":{"$lt":0.78}}}}
{"checkpoint":"picker_sv_changed"}
# The popup overlay itself is the shield: click it away from its content to dismiss.
{"click":{"widget":"ColorPickerOverlay","at":[0.06,0.11]}}
{"frame":2}
{"assert":{"layers":{"Popup":{"children":[]}}}}
{"checkpoint":"picker_dismissed"}
# Type 'To' then pick Torus by the label-derived menu item name.
{"click":{"widget":"GallerySearchCombo"}}
{"frame":2}
{"assert":{"widget":"GallerySearchCombo","control":{"type":"searchComboBox"}}}
{"checkpoint":"search_menu_open"}
{"event":"key_typed","text":"To"}
{"frame":2}
{"assert":{"widget":"GallerySearchCombo","control":{"type":"searchComboBox","filter":"To"}}}
{"checkpoint":"search_filtered"}
{"click":{"widget":"Menu_Torus"}}
{"frame":2}
{"assert":{"layers":{"Popup":{"children":[]}}}}
{"checkpoint":"search_picked"}
{"frame":70}
{"assert_validation_clean":true}
{"checkpoint":"validation_clean"}
{"frame":1}
