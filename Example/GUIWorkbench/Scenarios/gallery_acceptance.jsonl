# Picker stays open after SV pick; click the shield to dismiss before SearchCombo.
{"event":"mouse_press","x":80,"y":80,"button":0}
{"event":"mouse_release","x":80,"y":80,"button":0}
{"frame":2}
{"assert":{"layers":{"Popup":{"children":[]}}}}
{"checkpoint":"picker_dismissed"}
