# GUIWorkbench --start-page=Widgets. Fix the logical extent first so each
# coordinate is stable across host DPI, then exercise button, checkbox, slider,
# combo/focus and text commit through the same route path as native input.
{"window_size":{"width":960,"height":640}}
{"frame":3}
