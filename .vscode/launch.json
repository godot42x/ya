{
    "version": "2.0.0",
    "inputs": [
        {
            "id": "ya.project",
            "type": "promptString",
            "description": "Path to a .yaproject file relative to the workspace root.",
            "default": "Example/HelloMaterial/HelloMaterial.yaproject"
        },
        {
            "id": "pick-exe",
            "type": "command",
            "command": "extension.commandvariable.file.pickFile",
            "args": {
                "include": "**/*.{exe}"
            }
        }
    ],
    "configurations": [
        {
            "type": "lldb",
            "request": "launch",
            "name": "YA: Debug Runtime Project",
            "program": "${workspaceFolder}/build/macosx/arm64/debug/ya-runtime",
            "args": [
                "--project=${workspaceFolder}/${input:ya.project}"
            ],
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "ya build project",
            "env": {
                "DYLD_LIBRARY_PATH": "${workspaceFolder}/Engine/ThirdParty/VulkanSDK/1.4.341.1/macOS/lib:${env:DYLD_LIBRARY_PATH}",
                "VK_ICD_FILENAMES": "${workspaceFolder}/Engine/ThirdParty/VulkanSDK/1.4.341.1/macOS/share/vulkan/icd.d/MoltenVK_icd.json",
                "VK_LAYER_PATH": "${workspaceFolder}/Engine/ThirdParty/VulkanSDK/1.4.341.1/macOS/share/vulkan/explicit_layer.d"
            }
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "YA: Debug Editor Project",
            "program": "${workspaceFolder}/build/macosx/arm64/debug/ya-runtime",
            "args": [
                "--editor",
                "--project=${workspaceFolder}/${input:ya.project}"
            ],
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "ya build editor project",
            "env": {
                "DYLD_LIBRARY_PATH": "${workspaceFolder}/Engine/ThirdParty/VulkanSDK/1.4.341.1/macOS/lib:${env:DYLD_LIBRARY_PATH}",
                "VK_ICD_FILENAMES": "${workspaceFolder}/Engine/ThirdParty/VulkanSDK/1.4.341.1/macOS/share/vulkan/icd.d/MoltenVK_icd.json",
                "VK_LAYER_PATH": "${workspaceFolder}/Engine/ThirdParty/VulkanSDK/1.4.341.1/macOS/share/vulkan/explicit_layer.d"
            }
        },
        {
            "type": "cppvsdbg",
            "request": "attach",
            "name": "Attach EXE",
            "processId": "${command:pickProcess}"
        },
        {
            "type": "cppvsdbg",
            "name": "YA: Debug Runtime Project (MSVC)",
            "request": "launch",
            "program": "${workspaceFolder}/build/windows/x64/debug/ya-runtime.exe",
            "args": [
                "--project=${workspaceFolder}/${input:ya.project}"
            ],
            "logging": {
                "moduleLoad": true,
                "threadExit": true,
                "processExit": true,
                "programOutput": true,
                "engineLogging": false,
                "exceptions": true
            },
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "visualizerFile": "${workspaceFolder}/.vscode/all.natvis",
            "preLaunchTask": "ya build project",
            "requireExactSource": false
        },
        {
            "type": "cppvsdbg",
            "name": "YA: Debug Editor Project (MSVC)",
            "request": "launch",
            "program": "${workspaceFolder}/build/windows/x64/debug/ya-runtime.exe",
            "args": [
                "--editor",
                "--project=${workspaceFolder}/${input:ya.project}"
            ],
            "logging": {
                "moduleLoad": true,
                "threadExit": true,
                "processExit": true,
                "programOutput": true,
                "engineLogging": false,
                "exceptions": true
            },
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "visualizerFile": "${workspaceFolder}/.vscode/all.natvis",
            "preLaunchTask": "ya build editor project",
            "requireExactSource": false
        },
        {
            "type": "cppvsdbg",
            "name": "Debug EXE (MSVC)",
            "request": "launch",
            "program": "${input:pick-exe}",
            "logging": {
                "moduleLoad": true,
                "threadExit": true,
                "processExit": true,
                "programOutput": true,
                "engineLogging": false,
                "exceptions": true
            },
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "visualizerFile": "${workspaceFolder}/.vscode/all.natvis"
        }
    ]
}
